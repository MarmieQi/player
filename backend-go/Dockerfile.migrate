FROM golang:1.25-alpine AS build
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/config-migrate ./cmd/config-migrate
FROM alpine:3.22
COPY --from=build /out/config-migrate /app/config-migrate
ENTRYPOINT ["/app/config-migrate"]
