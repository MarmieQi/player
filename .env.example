# 玩家日志统计：服务器私有配置模板
# 首次部署：复制为同目录的 .env，再填写下面四个必填项。
# 已有服务器：先备份原 Compose，把原来的密码、JWT 密钥、端口和数据路径原样迁入。
# 不能通过修改这里的密码来修改已有 MySQL 用户或管理员密码。
# 日常升级保留 .env；不要把真实 .env 上传 GitHub 或发到聊天里。
# 除“首次初始化”项外，修改后需 docker compose up -d 重建对应容器才能生效。
# 密码或密钥包含 $、#、空格等特殊字符时，用英文单引号包住整个值。
# 例：MYSQL_PASSWORD='这里填写你自己的密码'，不要直接使用示例文字。

# ===== 一、必填：密码与签名密钥 =====

# MySQL 普通用户密码。后端自动复用这个值，不用再填第二遍。
# 新数据库用于创建用户；已有数据库必须填当前真实密码，改文件不会修改数据库密码。
MYSQL_PASSWORD=

# MySQL root 管理员密码。与普通用户密码分开设置，用于数据库管理及容器健康检查。
# 已有数据库填写当前真实 root 密码。
MYSQL_ROOT_PASSWORD=

# 后台管理员初始密码：只在指定用户名不存在时创建账号。
# 已有账号不会被重置；后续修改密码请进入后台“个人中心”。
APP_ADMIN_PASSWORD=

# 登录令牌签名密钥。建议使用至少 32 字节的随机值；可用 openssl rand -hex 32 生成。
# 已有服务器迁移时必须保留原值；更换会使现有登录令牌失效。
APP_ADMIN_JWT_SECRET=

# ===== 二、常用：版本、端口与持久化目录 =====

# 前后端共用镜像标签。默认 latest；正式部署也可填写同一次成功构建的完整提交 SHA。
# 回滚时也使用同一标签配对前后端；数据库结构变化是否兼容需另行核对。
IMAGE_TAG=latest

# 对外公开页面与 AstrBot 接口端口；默认访问 http://服务器IP:9493。
PUBLIC_PORT=9493

# 管理后台端口；默认访问 http://服务器IP:8843。
ADMIN_PORT=8843

# 宿主机数据根目录。包含 mysql、synced-logs、temp 三个子目录。
# 相对路径基于 Compose 项目目录；已有服务器必须指向原数据目录，不能随意更换。
DATA_DIRECTORY=./docker-data

# 首次创建的 MySQL 数据库名，使用字母、数字和下划线；已有部署保留原名称。
MYSQL_DATABASE=player_stats

# 首次创建的 MySQL 普通用户名；后端自动复用。已有部署保留原用户名。
MYSQL_USER=player_stats

# 后台管理员初始用户名。仅在该用户名不存在时创建；换名可能创建另一个管理员。
APP_ADMIN_USERNAME=admin

# 登录令牌有效天数，默认 7；用于后续登录签发的新令牌。
APP_ADMIN_TOKEN_TTL_DAYS=7

# ===== 三、高级：通常保持默认，不是后台业务开关 =====

# 主服本地 CSV 目录，指容器内部路径，默认对应宿主机 DATA_DIRECTORY/synced-logs/main。
PLAYER_LOGS_MAIN_DIRECTORY=/data/synced-logs/main

# 2服本地 CSV 目录，指容器内部路径，默认对应宿主机 DATA_DIRECTORY/synced-logs/sub。
PLAYER_LOGS_SUB_DIRECTORY=/data/synced-logs/sub

# 主服、2服本地文件匹配规则。只读取匹配的 CSV；也用作新日志源的初始化默认规则。
PLAYER_LOGS_MAIN_FILE_GLOB=player_actions_*.csv
PLAYER_LOGS_SUB_FILE_GLOB=player_actions_*.csv

# 启动层是否提供对应本地日志源，true/false。禁用会影响本地源映射及首次初始化。
# 通常保持 true；日常控制日志源是否启用请在后台修改，不能把此项当自动任务开关。
PLAYER_LOGS_MAIN_ENABLED=true
PLAYER_LOGS_SUB_ENABLED=true

# 首次初始化“跳过当天及未来 CSV”的默认值；已有数据库以后台设置为准。
PLAYER_LOGS_IMPORTER_SKIP_TODAY=true

# 目录扫描导入、同步流程每个日志源的文件处理上限，默认 1000。
# 这是处理上限，不是定时时间，也不是自动任务开关。
PLAYER_LOGS_IMPORTER_MAX_FILES_PER_RUN=1000

# 当天日志查询的临时快照目录，指容器内部路径，不会导入正式归档。
# 新安装默认使用已挂载的 temp 目录；旧配置迁移时保留原路径或旧版 Go 默认临时路径。
PLAYER_LOGS_LIVE_TEMP_DIRECTORY=/data/temp/live-log-query

# 当天日志只读快照复用秒数，默认 120；越大越少访问 SMB，数据刷新也越慢。
PLAYER_LOGS_LIVE_CACHE_SECONDS=120

# 每个服务器在数据库中保留的矿透分析任务数量，默认 1，至少 1；不是日志条数。
PLAYER_LOGS_XRAY_ANALYSIS_RETAINED_JOBS=1

# CORS 精确来源，多个值用英文逗号分隔。通过同域 NGINX 访问时一般无需修改。
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# CORS 来源匹配规则；默认供本地及局域网使用。跨域访问时按实际可信来源收窄。
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://10.*:*,http://172.*:*,http://192.168.*:*

# ===== 四、兼容：仅首次初始化 SMB，可不填写，推荐在后台配置 =====
# 这些值不会覆盖已保存的数据库设置；修改现有 SMB 连接、源、任务请进入“系统设置”。
# 主服/2服的自动复制、解析开关与每日时间仅在后台配置，没有 SMB_ENABLED 环境开关。

# SMB 服务器地址，空表示尚未配置。填写 IP 或主机名，不包含 smb://。
PLAYER_LOGS_SMB_HOST=

# SMB 端口，默认 445。
PLAYER_LOGS_SMB_PORT=445

# Windows 域或工作组；没有则留空。
PLAYER_LOGS_SMB_DOMAIN=

# 访问 SMB 的用户名；没有配置 SMB 时留空。
PLAYER_LOGS_SMB_USERNAME=

# 访问 SMB 的密码；新数据库初始化使用，已有连接以后台密码为准。
PLAYER_LOGS_SMB_PASSWORD=

# SMB 共享名，例如 mcshare；不是远程服务器的磁盘路径。
PLAYER_LOGS_SMB_SHARE=

# 共享下的日志子目录，默认 logs；初始化日志源后可在后台分别调整。
PLAYER_LOGS_SMB_DIRECTORY=logs

# 远程日志文件匹配规则，初始化日志源使用。
PLAYER_LOGS_SMB_FILE_GLOB=player_actions_*.csv

# 是否递归扫描远程日志子目录，true/false，初始化日志源使用。
PLAYER_LOGS_SMB_RECURSIVE=false
