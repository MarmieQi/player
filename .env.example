# 玩家日志统计 · SQLite 部署配置
# 首次部署复制为 .env。真实密码和密钥不得上传 GitHub。
# 部署参数修改后执行 docker compose up -d 重建对应容器。

# 正式环境使用同次构建的完整提交 SHA 配对前后端。
IMAGE_TAG=latest
PUBLIC_PORT=9493
ADMIN_PORT=8843

# 必须位于 NAS 本地磁盘，不能是 SMB/NFS 挂载。挂载整个 database 目录。
# 目录包含 database、synced-logs、temp；旧 mysql 目录不会被自动删除。
DATA_DIRECTORY=./docker-data

# 仅在首次没有管理员时初始化。已有账号不会被重置。
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
# 至少 32 字节的随机签名密钥。迁移时保留原值，数据库实例变化会使旧登录失效。
APP_ADMIN_JWT_SECRET=
APP_ADMIN_TOKEN_TTL_DAYS=7

# 容器内部归档目录，默认对应 DATA_DIRECTORY/synced-logs 下 main/sub。
# 旧部署有自定义本地目录时保留原路径和对应挂载。
PLAYER_LOGS_MAIN_DIRECTORY=/data/synced-logs/main
PLAYER_LOGS_SUB_DIRECTORY=/data/synced-logs/sub
PLAYER_LOGS_MAIN_FILE_GLOB=player_actions_*.csv
PLAYER_LOGS_SUB_FILE_GLOB=player_actions_*.csv
PLAYER_LOGS_MAIN_ENABLED=true
PLAYER_LOGS_SUB_ENABLED=true
PLAYER_LOGS_LIVE_TEMP_DIRECTORY=/data/temp/live-log-query

# 同域反向代理通常保持默认；多个来源用英文逗号分隔。
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://10.*:*,http://172.*:*,http://192.168.*:*

# SMB、日志来源、自动任务、跳过当天、分享和运行参数统一在系统设置管理。
# 缓存秒数、单轮文件上限、分析保留数保存后 docker compose restart backend 生效。
